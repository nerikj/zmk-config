
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define NAV 1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Swedish QWERTY";

            bindings = <
                &none          &kp Q         &kp W         &kp E         &kp R         &kp T                     &kp Y         &kp U         &kp I         &kp O          &kp P          &kp LBKT
                &none          &mt LGUI A    &mt LALT S    &mt LCTRL D   &mt LSHFT F   &kp G                     &kp H         &mt RSHFT J   &mt RCTRL K   &mt RALT L     &mt RGUI SEMI  &kp SQT
                &none          &kp Z         &kp X         &kp C         &kp V         &kp B                     &kp N         &kp M         &kp COMMA     &kp DOT        &kp LS(N7)     &kp FSLH
                                                       &kp ESC       &lt NAV SPACE  &kp TAB       &kp RET       &kp BSPC      &kp DEL
            >;
        };

        nav_layer {
            display-name = "Nav";

            bindings = <
                &none          &none          &none          &none          &none          &none                     &kp LS(LG(Z)) &kp LG(V)     &kp LG(C)     &kp LG(X)      &kp LG(Z)      &none
                &none          &kp LGUI       &kp LALT       &kp LCTRL      &kp LSHFT      &none                     &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT      &none          &none
                &none          &none          &none          &none          &none          &none                     &kp HOME      &kp PG_DN     &kp PG_UP     &kp END        &kp INS        &none
                                                       &trans        &trans         &trans        &kp RET       &kp BSPC      &kp DEL
            >;
        };
    };
};
